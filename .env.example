# Folio Server Configuration
PORT=8080
DATA_DIR=./data

# Database Configuration:
# Option 1: SQLite (Default)
DB_DRIVER=sqlite
DB_DSN=./data/folio.db

# Option 2: PostgreSQL
# DB_DRIVER=postgres
# DB_DSN=postgres://folio:folio@localhost:5432/folio?sslmode=disable

# Optional Public Base URL (used for absolute links in OPDS feeds)
BASE_URL=

# Tailscale Zero-Trust Authentication
# Modes: "auto" (default), "required" (strict zero-trust), "off"
TAILSCALE_AUTH_MODE=auto
TS_SOCKET=/var/run/tailscale/tailscaled.sock
TAILSCALE_TRUST_HEADERS=true
# Comma-separated list of allowed Tailscale logins or @domain (empty = allow any tailnet user)
TAILSCALE_ALLOWED_USERS=
# Whether /opds requires Tailscale auth (false allows e-readers on LAN to fetch OPDS)
TAILSCALE_PROTECT_OPDS=false
# Optional Tailscale auth key when running the Docker tailscale sidecar profile
TS_AUTHKEY=
TS_HOSTNAME=folio

# KOReader / CrossPoint Progress Sync Settings
DEFAULT_SYNC_USER=reader
DEFAULT_SYNC_PASSWORD=folio123
REGISTRATION_ENABLED=true

# Seed 4 classic public-domain EPUBs if library is empty
SEED_SAMPLE_BOOKS=true

# Enable built-in local CrossPoint Reader Simulator (ports 18080 / 18081) for testing
ENABLE_MOCK_X3=true
